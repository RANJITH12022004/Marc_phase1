<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Dark only: keep parent DayNight but pin night with
        AppCompatDelegate.setDefaultNightMode(AppCompatDelegate.MODE_NIGHT_YES) in Application or MainActivity.
        UI fonts: Space Grotesk | Mono labels: IBM Plex Mono — wire @font when files are added.
    -->

    <style name="Theme.MARC" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorPrimary</item>
        <item name="android:statusBarColor">@color/colorNavBackground</item>
        <item name="android:navigationBarColor">@color/colorNavBackground</item>
        <item name="colorControlHighlight">#22FF2020</item>
        <item name="colorControlNormal">#555555</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textMuted</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.MARC.Splash" parent="Theme.MARC">
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <style name="Theme.MARC.FullScreen" parent="Theme.MARC">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
