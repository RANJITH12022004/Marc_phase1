<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Pico W + local Ollama use plain HTTP on the LAN (no TLS on device). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
