<?xml version="1.0" encoding="utf-8"?>
<!-- BottomNavigationView: pressed → lighter red, checked → primary, idle → muted -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/colorPrimaryLight" android:state_pressed="true" />
    <item android:color="@color/colorPrimary" android:state_checked="true" />
    <item android:color="@color/colorNavUnselected" />
</selector>
