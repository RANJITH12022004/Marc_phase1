<?xml version="1.0" encoding="utf-8"?>
<!-- 17 — CHAT BUBBLE: Marc — body + 2dp left accent -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:top="0dp"
        android:width="@dimen/border_width_accent">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorPrimary" />
        </shape>
    </item>
    <item
        android:bottom="0dp"
        android:left="@dimen/border_width_accent"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorCardDefault" />
            <stroke
                android:width="@dimen/border_width"
                android:color="@color/colorBorder" />
            <corners android:radius="@dimen/corner_radius_sharp" />
        </shape>
    </item>
</layer-list>
