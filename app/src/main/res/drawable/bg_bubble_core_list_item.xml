<?xml version="1.0" encoding="utf-8"?>
<!-- Static "pulse" halo: outer soft red stroke + inner core panel (no runtime animation). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorTransparent" />
            <stroke
                android:width="@dimen/border_width_accent"
                android:color="#66FF2020" />
            <corners android:radius="@dimen/corner_radius_sharp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorCoreDark" />
            <stroke
                android:width="@dimen/border_width"
                android:color="@color/colorPrimary" />
            <corners android:radius="0dp" />
        </shape>
    </item>
</layer-list>
