<?xml version="1.0" encoding="utf-8"?>
<!-- MARC — slide in from left + fade in (-80dp, 350ms) -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="350">
    <translate
        android:fromXDelta="-80dp"
        android:toXDelta="0" />
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0" />
</set>
